rules_version = '2';

// 幹事の一覧（access/kanji の emails）に入っているアカウントだけが読み書きできる。
// 認めるのは「メールアドレスを確認済みの Google アカウント」と「幹事で共有するパスワードのアカウント 1 つ」だけ。
// 幹事の一覧そのものはアプリからは読めず、Firebase コンソールでだけ編集する。
service cloud.firestore {
  match /databases/{database}/documents {

    function verifiedOrShared() {
      return request.auth.token.email_verified == true
        || (request.auth.token.firebase.sign_in_provider == 'password'
            && request.auth.token.email == 'kanji@otyakai-kaikei.firebaseapp.com');
    }

    function isKanji() {
      return request.auth != null
        && request.auth.token.email is string
        && verifiedOrShared()
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/access/kanji).data.emails;
    }

    match /access/{doc} {
      allow read, write: if false;
    }

    match /config/{doc} {
      allow read, create, update: if isKanji();
    }

    match /periods/{pid} {
      allow read, create, update: if isKanji();

      match /charges/{mid} {
        allow read, create, update: if isKanji();
      }
    }

    // 記録の履歴は追記だけ（あとから書き換え・削除できない）
    match /log/{id} {
      allow read, create: if isKanji();
    }
  }
}
